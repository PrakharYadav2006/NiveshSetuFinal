# Copy to a file named exactly ".env" (not .env.txt) and fill in. NEVER commit .env.
# Sarvam does everything: the AI coach, the voice (Simran / Aditya) and speech-to-text → https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional overrides
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_REASONING=low            # low = fastest; set to "default" to let the model think longer
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_STT_MODEL=saarika:v2.5
TTS_SPEAKER_TIPSTER=aditya
TTS_SPEAKER_APP=simran
